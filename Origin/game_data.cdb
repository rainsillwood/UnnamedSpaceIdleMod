			"props": {
				"separatorTitles": [
					"Capital Battleship Normal enemy shards change to guaranteed drop and small amounts.  0.1 per wave.  0.005 per 1 weight | Swarmer: .001, Skirmisher: .0025, Fighter: .005, Sniper: .01, Big: .02, Huge: .03"
				]
