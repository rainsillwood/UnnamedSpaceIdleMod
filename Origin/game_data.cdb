		},
		{
			"name": "ai_dialogue",
			"columns": [
				{
					"typeStr": "0",
					"name": "id"
				},
				{
					"typeStr": "6:ai_dialogue",
					"name": "next_text",
					"opt": true
				},
				{
					"typeStr": "1",
					"name": "group_display"
				},
				{
					"typeStr": "1",
					"name": "highlight_node_parent"
				},
				{
					"typeStr": "1",
					"name": "highlight_node",
					"display": null
				},
				{
					"typeStr": "2",
					"name": "require_node_click",
					"display": null
				},
				{
					"typeStr": "1",
					"name": "offset_vector"
				},
				{
					"typeStr": "1",
					"name": "text",
					"display": null
				}
			],
			"lines": [
				{
					"id": "start",
					"text": "Greetings captain, it has been 10,485 years since you were stored.  You have been inserted into a biosleeve as the time has finally come to attempt to push back the enemy.  We will face endless assault, but we must persevere.  Our first goal is to push into enemy controlled areas as far as possible and gather better data.",
					"next_text": "start_2",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Opening",
					"highlight_node_parent": ""
				},
				{
					"id": "start_2",
					"group_display": "Opening",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "My communications with you will pause time by default, you can change this on the settings tab after this if you want.",
					"next_text": "start_3",
					"highlight_node_parent": ""
				},
				{
					"id": "start_3",
					"text": "We will be able to upgrade our systems with salvage from defeated foes.  Start us moving forwards by clicking forward in the navigation section.",
					"highlight_node": "btnGo",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Opening",
					"highlight_node_parent": ""
				},
				{
					"id": "mobile_start",
					"group_display": "Opening",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Greetings captain, it has been 10,485 years since you were stored.  You have been inserted into a biosleeve as the time has finally come to attempt to push back the enemy.  We will face endless assault, but we must persevere.  Our first goal is to push into enemy controlled areas as far as possible and gather better data.",
					"next_text": "mobile_start_2",
					"highlight_node_parent": ""
				},
				{
					"id": "mobile_start_2",
					"group_display": "Opening",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "My communications with you will pause time by default, you can change this on the settings tab after this if you want.",
					"next_text": "mobile_start_3",
					"highlight_node_parent": ""
				},
				{
					"id": "mobile_start_3",
					"group_display": "Opening",
					"highlight_node": "BtnMobileTooltip",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Many buttons and icons have more information available. Pressing the Show Tooltips button will switch to a tooltip mode and cause anything with more information available to flash. Pressing any of the flashing icons will popup their tooltip information.",
					"next_text": "mobile_start_4",
					"highlight_node_parent": ""
				},
				{
					"id": "mobile_start_4",
					"group_display": "Opening",
					"highlight_node": "btnGo",
					"require_node_click": true,
					"offset_vector": "",
					"text": "We will be able to upgrade our systems with salvage from defeated foes.  Start us moving forwards by clicking forward in the navigation section.",
					"highlight_node_parent": ""
				},
				{
					"id": "mobile_tooltip_button",
					"group_display": "Opening",
					"highlight_node": "BtnMobileTooltip",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Many buttons and icons have more information available. Pressing the Show Tooltips button will switch to a tooltip mode and cause anything with more information available to flash. Pressing any of the flashing icons will popup their tooltip information.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_shields_down",
					"text": "When shields are reduced to 0 the ship will automatically engage an emergency retreat until shields are back to full and then stop.  We cannot risk complete destruction prematurely.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Shields",
					"highlight_node_parent": ""
				},
				{
					"id": "compute_notification",
					"text": "In addition to upgrading your cores with salvage, we can improve some things with computation power.  Click the Compute tab up top.",
					"highlight_node": "btnComputation",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Compute",
					"highlight_node_parent": ""
				},
				{
					"id": "ComputationArea_first_click",
					"text": "In addition to upgrades from salvage we can continually improve some systems by devoting computing resources in the Compute section.  Computation power can be improved with Void Matter that will sometimes be recoverable from enemies.",
					"highlight_node": "ComputeUpgrade",
					"require_node_click": false,
					"next_text": "ComputationArea_first_click2",
					"offset_vector": "",
					"group_display": "Compute",
					"highlight_node_parent": ""
				},
				{
					"id": "ComputationArea_first_click2",
					"text": "Compute power can be distributed to various upgrades using the buttons to the right of them.  + and - will add or remove the amount designated.  1/2 will use half your available compute power and max will use it all.",
					"highlight_node": "ComputeOffense1",
					"require_node_click": false,
					"next_text": "ComputationArea_first_click3",
					"offset_vector": "",
					"group_display": "Compute",
					"highlight_node_parent": ""
				},
				{
					"id": "ComputationArea_first_click3",
					"text": "Salvage can additionally be used to improve performance.",
					"highlight_node": "ComputeSalvagePerSecond",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Compute",
					"highlight_node_parent": ""
				},
				{
					"id": "void_spawn_first",
					"text": "Spatial anomalies are relatively common around the enemy.  Pick them up to boost most non-combat systems.  Also keep an eye out for salvage wrecks that can be recovered.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Void Energy",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_one_clear",
					"text": "We have overcome our first big obstacle.  It looks like that ship had a fully intact Synth setup on it.  We can utilize that ourselves, click Synth up top to get started.",
					"highlight_node": "btnSynth",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Synth",
					"highlight_node_parent": ""
				},
				{
					"id": "SynthArea_first_click",
					"text": "Synthing will allow us to create various materials which we can then use to create Modules that will improve the ship.  As you Synth a material, we will become more proficient at it, which will convey various benefits.  You will get 1 Synth Point per level to spend on upgrades.",
					"next_text": "SynthArea_first_click2",
					"highlight_node": "Synth1",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Synth",
					"highlight_node_parent": ""
				},
				{
					"id": "SynthArea_first_click2",
					"text": "Synthing will continue until you stop it.  Start by creating some Refined Alloy.",
					"highlight_node": "btnModules",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Synth",
					"highlight_node_parent": ""
				},
				{
					"id": "ModuleArea_first_click",
					"text": "Once created, modules can be turned on or off at will, there is a limit to how many we can support being on at one time.  Select one below to see what materials are needed to create it.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Synth",
					"next_text": "ModuleArea_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "ModuleArea_first_click2",
					"group_display": "Synth",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "When all the required materials for a module are made infinite, it will start on that tier.",
					"highlight_node_parent": ""
				},
				{
					"id": "core_upgrade_first_split",
					"text": "Some milestones for your cores provide more than one option.  Only one can be active at a time per section.  By default the top selection will be activated.  Click one to swap which is active.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Core Milestones",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_two_clear",
					"text": "Excellent work, now that your competence has been illustrated we can commit serious resources to you.  An unknown alien device was recovered 4829 years ago, after much study it was found to be similar to the enemies' technology and could do interesting things with their materials.",
					"highlight_node": "",
					"require_node_click": false,
					"next_text": "sector_two_clear2",
					"offset_vector": "",
					"group_display": "Void Device",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_two_clear2",
					"text": "It can be imprinted onto a human and will follow them through space and time.  Critically it somehow does this even for biosleeves of the same individual.  When you perish, as soon as another biosleeve is created with your imprint in it the device will simply appear.  Click the V. Device button up top.",
					"highlight_node": "btnVoidDevice",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Void Device",
					"highlight_node_parent": ""
				},
				{
					"id": "VoidDeviceArea_first_click",
					"text": "Any time we are able to recover a Void Shard from an enemy it will show up here.  Shards can fit in certain slots and will receive a bonus in addition to the base effect depending on the slot.  These will stay with us at all times.",
					"highlight_node": "",
					"next_text": "VoidDeviceArea_first_click2",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Void Device",
					"highlight_node_parent": ""
				},
				{
					"id": "VoidDeviceArea_first_click2",
					"text": "Shards can be combined with other shards of the same name.  We have 2 already so try combining them by dragging one onto the other, this will result in a shard with higher resonance.  Resonance is what determines how powerful the effect of the shard will be.  Once that is done drag it up to the appropriate slot to equip it.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Void Device",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_three_clear",
					"text": "We've gotten far enough that it might be time to consider utilizing our gathered data to improve the next ship.  Click Prestige up top.",
					"highlight_node": "btnPrestige",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Prestige",
					"highlight_node_parent": ""
				},
				{
					"id": "PrestigeArea_first_click",
					"text": "This section is an indicator of progress towards our main goal, to reach further into enemy space and in turn discover more powerful ships and weaponry to combat them.  New innovations are displayed here, click to unlock them.",
					"highlight_node": "DataButtonUnlock",
					"next_text": "PrestigeArea_first_click2",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Prestige",
					"highlight_node_parent": ""
				},
				{
					"id": "PrestigeArea_first_click2",
					"text": "Determine the ship and loadout that will be built for the next generation.  When it seems we can't progress any further and there are new unlocks to use, hit prestige reset to self destruct and let your next generation try with improved odds.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Prestige",
					"next_text": "PrestigeArea_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "PrestigeArea_first_click3",
					"group_display": "Prestige",
					"highlight_node": "btnSectorInfo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can use the information in Sector Data to determine how best to set up your ship for the next run.",
					"highlight_node_parent": ""
				},
				{
					"id": "death_after_prestige_unlock",
					"text": "We are being overwhelmed by faster small ships.  We may not be able to continue past this point in our current ship.  You will need to end it and leave it to the next generation.",
					"highlight_node": "",
					"next_text": "death_after_prestige_unlock2",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Small Enemy Tip",
					"highlight_node_parent": ""
				},
				{
					"id": "death_after_prestige_unlock2",
					"text": "Set up the next ship to use at least one Gatling Laser and click reset on the prestige tab.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Small Enemy Tip",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_four_clear",
					"text": "We've certainly attracted their attention at this point, expect resistance to ramp up quicker.  We are also able to convert Void Matter (the same resource used to upgrade compute power) into Power now, click Reactor up top.",
					"highlight_node": "btnReactor",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Reactor",
					"highlight_node_parent": ""
				},
				{
					"id": "ReactorArea_first_click",
					"text": "Here we can generate void power using the void matter that enemies sometimes drop (you can see the base drop rate in the Sector Data tab after clicking an enemy).  You can set how much void matter to consume using the entry box and buttons.  The maximum amount consumed and several other stats can be upgraded.",
					"highlight_node": "VoidMatterGen",
					"require_node_click": false,
					"next_text": "ReactorArea_first_click2",
					"offset_vector": "",
					"group_display": "Reactor",
					"highlight_node_parent": ""
				},
				{
					"id": "ReactorArea_first_click2",
					"text": "The void matter will be consumed over a period of time and will generate void power while that is happening. You can see the duration that lasts and some other stats on the left.",
					"highlight_node": "ReactorStatsAreaOutliner",
					"require_node_click": false,
					"next_text": "ReactorArea_first_click3",
					"offset_vector": "",
					"group_display": "Reactor",
					"highlight_node_parent": ""
				},
				{
					"id": "ReactorArea_first_click3",
					"text": "You can permanently upgrade some of these by using power.  These stats can also be affected by various other parts of the ship.  There is also a new module available in the synth section.",
					"highlight_node": "ReactorUpgradeAreaOutliner",
					"require_node_click": false,
					"next_text": "ReactorArea_first_click4",
					"offset_vector": "",
					"group_display": "Reactor",
					"highlight_node_parent": ""
				},
				{
					"id": "ReactorArea_first_click4",
					"text": "Void power can then be used to power various boosts down below.  Eventually you will be able to run multiple at once but for now just focus on sustaining 1.  Power generation might be very inconsistent depending on how other areas of the ship are configured.",
					"highlight_node": "PowerComputeSpeedBoost",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Reactor",
					"highlight_node_parent": ""
				},
				{
					"id": "first_tier_2_shard",
					"text": "We just found a tier 2 void shard.  Only one shard with the same name can be equipped at once or there will be a bad chain reaction.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Void Shard Tier 2",
					"next_text": "first_tier_2_shard_2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_tier_2_shard_2",
					"group_display": "Void Shard Tier 2",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can see where void shards drop and the drop rate on the Sector Data tab.  Click enemies for more details once there.",
					"highlight_node_parent": ""
				},
				{
					"id": "LoadoutsArea_first_click",
					"group_display": "Loadouts",
					"highlight_node": "CoreSettings",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Loadouts save your setup in several systems, you can choose which of those systems to include in a given loadout and save or load them individually if desired.",
					"next_text": "LoadoutsArea_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "LoadoutsArea_first_click2",
					"group_display": "Loadouts",
					"highlight_node": "gFavoriteLoadouts",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can have up to 8 favorites that show up top at all times, left clicking will load and right clicking will save.",
					"next_text": "LoadoutsArea_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "LoadoutsArea_first_click3",
					"group_display": "Loadouts",
					"highlight_node": "LoadoutsAutoUpdate",
					"require_node_click": false,
					"offset_vector": "",
					"text": "By default, loadouts will stay highlighted once loaded until you change something.  You can enable auto update to have them automatically save any changes you make, just make sure you remember it is on.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_five_clear",
					"text": "An additional slot in the Void Device has activated, try to put shards in the best slot for our current needs.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Void Shard Slots",
					"highlight_node_parent": ""
				},
				{
					"id": "death_after_snipers",
					"text": "Those ships at a distance with the heavy hitting weapons are a problem, we need to kill them before they fire.  The Charge Laser has a longer range and would be useful against them.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Sniper Enemy Tip",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_six_clear",
					"text": "We can now use information gathered from battling enemies to research various permanent upgrades.  Click the Research button.",
					"highlight_node": "btnResearch",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Research",
					"highlight_node_parent": ""
				},
				{
					"id": "ResearchArea_first_click",
					"text": "Destroying enemies will grant us research data.  How much of each type we get per kill is dependent on the sector, this is represented by the Sector Density shown in each section.  You can make progress in one of each research type simultaneously.",
					"highlight_node": "lblDensity",
					"require_node_click": false,
					"next_text": "ResearchArea_first_click2",
					"offset_vector": "",
					"group_display": "Research",
					"highlight_node_parent": ""
				},
				{
					"id": "ResearchArea_first_click2",
					"text": "You can also choose a research to focus in which will grant a 9X bonus to the gain for that research.  Focus either the research you want to make the most progress in or the research that has the highest density in this sector for best results. Choose this one for now.",
					"highlight_node": "btnFocus",
					"require_node_click": true,
					"next_text": "ResearchArea_first_click3",
					"offset_vector": "",
					"group_display": "Research",
					"highlight_node_parent": ""
				},
				{
					"id": "ResearchArea_first_click3",
					"text": "You must also choose which research within the section progress will be applied to, Click them to designate which one you want to work.  No progress will be made if a research is not selected, so make sure a research is highlighted in all three of the research sections. Select Compute Speed in this column for now, then choose one in each of the others.",
					"highlight_node": "MRComputeSpeed1",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Research",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_eight_clear",
					"text": "Occasionally there will be more than one way forward and we will be able to choose which route to take.  There may be different research data and enemies down each route, usually we will have some knowledge of what to expect.",
					"highlight_node": "",
					"require_node_click": false,
					"next_text": "sector_eight_clear2",
					"offset_vector": "",
					"group_display": "Routes",
					"highlight_node_parent": "RouteSelect"
				},
				{
					"id": "sector_eight_clear2",
					"text": "You can see your choices in the battle area as well as some info about them.  It might be worth going down both routes but you will have ample chances to do that so it's best to just push as far as we can for now.  Your choice here is not permanent and you can always come back to this position and go the other way.  Route A is best handled with at least one Charge Laser equipped.  Route B is best handled with two Gatling Lasers equipped.",
					"highlight_node": "SectorInfo",
					"require_node_click": false,
					"next_text": "sector_eight_clear3",
					"offset_vector": "",
					"group_display": "Routes",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_eight_clear3",
					"text": "You can get a little more detailed information by clicking the sector data button and selecting the sectors To see what types of enemies are there as well as a hint of what they drop.",
					"highlight_node": "btnSectorInfo",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Routes",
					"highlight_node_parent": ""
				},
				{
					"id": "SectorArea_first_click",
					"text": "Here we can view the information for sectors we have been to or are about to be in.  Click a sector to see more information and click an enemy to get more information on them and see what they may drop.  ",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Routes",
					"highlight_node_parent": ""
				},
				{
					"id": "first_ai_point_save",
					"text": "You just received AI points as a bonus for making that backup save.  AI Points can be used to buy various convenience or automation upgrades.  Auto Merge or Smart Craft are recommended first purchases.  Click the AI tab.",
					"highlight_node": "btnAI",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "AI Points",
					"highlight_node_parent": ""
				},
				{
					"id": "AIArea_first_click",
					"text": "AI Points are gained from achievements, backup saves, codes and other systems.  You can spend AI points here for automation or QOL upgrades.  More upgrades will become available as you progress.  You will gain enough to unlock everything here through normal gameplay.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"next_text": "AIArea_first_click2",
					"group_display": "AI Points",
					"highlight_node_parent": ""
				},
				{
					"id": "AIArea_first_click2",
					"text": "As you accumulate more you will also unlock bonuses in the Accumulation tab, you do not have to spend your AI points for these bonuses.",
					"highlight_node": "btnAccumulation",
					"require_node_click": false,
					"offset_vector": "",
					"next_text": "AIArea_first_click3",
					"group_display": "AI Points",
					"highlight_node_parent": ""
				},
				{
					"id": "AIArea_first_click3",
					"text": "Eventually you will unlock consumables that have various time saving effects.",
					"highlight_node": "btnAIConsumables",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "AI Points",
					"highlight_node_parent": ""
				},
				{
					"id": "Cruiser_first_click",
					"text": "The cruiser has room for two shield generators.  When you have multiple shields, the damage is split between them.  They each also regenerate based on their own stats.  Mixing different types of shield generators can be quite powerful.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Cruiser",
					"highlight_node_parent": ""
				},
				{
					"id": "death_after_shield_regen",
					"text": "The specialized fighters in this area have a rapidly regenerating shield that starts nearly instantly after being hit.  We either need to be able to kill them in one hit, or use a beam weapon that will prevent their shield recharge while attached.  We should be able to manufacture a beam weapon shortly.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Shield Regen Enemy Tip",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_eleven_clear",
					"text": "We are approaching an alien mega structure. It is still a couple of sectors away, but expect the resistance to ramp up as we get closer.  Utilizing the targetting controls will be very important.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Targeting Controls",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_thirteen_clear",
					"text": "We should be able to utilize this structure.  Click the Bases tab.",
					"highlight_node": "btnBases",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Bases",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click",
					"text": "You can view bases we have access to here.  Each base will have its own unique resources, buildings, bonuses and upgrades.  Bases will unlock as you reach them and destroy their guardian.",
					"highlight_node": "",
					"require_node_click": false,
					"next_text": "ForwardBaseArea_first_click2",
					"offset_vector": "",
					"group_display": "Bases",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click2",
					"text": "You can see the resources the base generates here.  These resources are used for either buildings and upgrades, or a stat bonus.",
					"highlight_node": "Resources",
					"require_node_click": false,
					"next_text": "ForwardBaseArea_first_click3",
					"offset_vector": "",
					"group_display": "Bases",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click3",
					"text": "The stat bonus for this base is shown here.  These scale on one of the resources the base produces.",
					"highlight_node": "UpgradeInfo",
					"require_node_click": false,
					"next_text": "ForwardBaseArea_first_click4",
					"offset_vector": "",
					"group_display": "Bases",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click4",
					"text": "Click the Manage button.",
					"highlight_node": "btnManage",
					"require_node_click": true,
					"next_text": "ForwardBaseArea_first_click5",
					"offset_vector": "",
					"group_display": "Bases",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click5",
					"text": "Each base has slots for buildings, a few are available from the start and more can be purchased with resources that are generated, but they will not be available until the next prestige reset.",
					"highlight_node": "GenerationGrid",
					"require_node_click": false,
					"next_text": "ForwardBaseArea_first_click6",
					"offset_vector": "",
					"group_display": "Bases",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click6",
					"text": "Buildings can be placed on the grid by clicking one to select it, then clicking on any active square on the grid.  Buildings can also be upgraded to produce more or increase their effect.",
					"highlight_node": "GenerationPieces",
					"require_node_click": false,
					"next_text": "ForwardBaseArea_first_click7",
					"offset_vector": "",
					"group_display": "Bases",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click7",
					"text": "Finally, there will be a few unique upgrades purchaseable that have a large impact.",
					"highlight_node": "Upgrades",
					"require_node_click": false,
					"next_text": "ForwardBaseArea_first_click8",
					"offset_vector": "",
					"group_display": "Bases",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click8",
					"text": "You should produce as much of the basic resource as you can.",
					"highlight_node": "firstBuildingMaterialGenerator",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Bases",
					"next_text": "ForwardBaseArea_first_click9",
					"highlight_node_parent": ""
				},
				{
					"id": "ForwardBaseArea_first_click9",
					"group_display": "Bases",
					"highlight_node": "firstShipComponentGenerator",
					"require_node_click": false,
					"offset_vector": "",
					"text": "But still produce plenty of the component resource as this increases the stat bonus shown above and is the main way the base contributes to your overall power.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_seventeen_clear",
					"text": "We can now experiment with a few of our systems to improve them. Click the Challenges tab.",
					"highlight_node": "btnChallenges",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Challenges",
					"highlight_node_parent": ""
				},
				{
					"id": "ChallengeArea_first_click",
					"text": "Challenges let us run the ship with one or more of our systems altered.  Completing these will improve that system significantly.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"next_text": "ChallengeArea_first_click2",
					"group_display": "Challenges",
					"highlight_node_parent": ""
				},
				{
					"id": "ChallengeArea_first_click2",
					"text": "Many upgrades are often disabled, so you should focus specifically on the system in question.",
					"highlight_node": "lblDescriptionNegative",
					"require_node_click": false,
					"offset_vector": "",
					"next_text": "ChallengeArea_first_click3",
					"group_display": "Challenges",
					"highlight_node_parent": ""
				},
				{
					"id": "ChallengeArea_first_click3",
					"text": "You should be able to do the first Core Computing challenge soon if not right now. The other ones will be a bit harder and you will need to improve those systems a bit more before you attempt them.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Challenges",
					"highlight_node_parent": ""
				},
				{
					"id": "compute_challenge_BasicArea_first_click",
					"group_display": "Core Computing Challenge",
					"highlight_node_parent": "",
					"highlight_node": "BeamLaserMile72",
					"require_node_click": false,
					"offset_vector": "",
					"text": "In this challenge, damage and shield upgrades from cores are multiplied by 10. This makes certain nodes much better, for example the Mass Focuser upgrade on your Beam Laser is very powerful now, so choose that node once you can unlock it.",
					"next_text": "compute_challenge_BasicArea_first_click2"
				},
				{
					"id": "compute_challenge_BasicArea_first_click2",
					"group_display": "Core Computing Challenge",
					"highlight_node_parent": "CoreUpgradeArea",
					"highlight_node": "LaserCanonMile72",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Your other weapons have all been set to Laser Cannon by default, as the Supportive Routing node is also very powerful. Configure your Laser Cannons to support your Beam Laser."
				},
				{
					"id": "death_after_armor",
					"text": "It looks like we are starting to encounter enemies with ARMOR.  If their bar is red instead of yellow it means their hull is armored.  Lasers are very ineffective against armor and do only 1/4th the normal damage.  Kinetic weapons will be necessary to deal with them.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Armored Enemy Tip",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_twentyone_clear",
					"text": "It seems that ship had an intact warp drive and some warp coordinates.  Click the Warp Drive button",
					"highlight_node": "btnWarp",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpArea_first_click",
					"text": "With the warp drive, we can jump to specific locations we have the coordinates for and run a short gauntlet of enemies.  We will be able to gather warp essence from the enemies there.  More warp areas can be found on more difficult routes.",
					"highlight_node": "",
					"require_node_click": false,
					"next_text": "WarpArea_first_click2",
					"offset_vector": "",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpArea_first_click2",
					"text": "To warp, we need a warp core charged up and ready to go, they will charge up one at a time.  Fortunately we recovered several fully charged so it is ready now.",
					"highlight_node": "WarpCores",
					"require_node_click": false,
					"next_text": "WarpArea_first_click3",
					"offset_vector": "",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpArea_first_click3",
					"text": "Here you can see the available locations and some relevant information, right now we have 3 locations, but more will be unlocked in the future.",
					"highlight_node": "AvailableJumps",
					"require_node_click": false,
					"next_text": "WarpArea_first_click4",
					"offset_vector": "",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpArea_first_click4",
					"text": "Here you can see the max difficulty we have available for this location.  The number is representative of the equivalent sector.  When a difficulty is fully cleared a higher one will be available the next time the warp is opened.",
					"highlight_node": "VBoxDiffIndicator",
					"require_node_click": false,
					"next_text": "WarpArea_first_click5",
					"offset_vector": "0,200",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpArea_first_click5",
					"text": "When you are ready, click Open Warp on one of the locations to open the warp.  Try to match your loadout to best take on the enemies listed.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "0,200",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpOpened_first_time",
					"text": "Now that the warp is open, it will remain so for some time.  You can jump to the location as many times you want until time runs out or you manually close the warp.",
					"highlight_node": "",
					"require_node_click": false,
					"next_text": "WarpOpened_first_time2",
					"offset_vector": "0,200",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpOpened_first_time2",
					"text": "You can see the jump and its difficulty and Warp Essence.  This amount of Warp Essence is for fully clearing the enemies, if you fail you will receive a partial amount of Essence.",
					"highlight_node": "",
					"require_node_click": false,
					"next_text": "WarpOpened_first_time3",
					"offset_vector": "0,200",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpOpened_first_time3",
					"text": "You can jump multiple times, but warp essence is fickle and only your best amount gathered will be kept.  You will receive it upon the warp closing.  If you clear the highest difficulty available, the next highest will become available, this allows you to catch warps up that are behind.",
					"highlight_node": "",
					"require_node_click": false,
					"next_text": "WarpOpened_first_time4",
					"offset_vector": "0,200",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpOpened_first_time4",
					"text": "Our Essence gathering ability improves over time, each unique location and difficulty cleared will increase how much we gather per jump, seen here.  It is best to try to keep each location as high as you can to increase this bonus.",
					"highlight_node": "lblCompletionBonus",
					"require_node_click": false,
					"next_text": "WarpOpened_first_time5",
					"offset_vector": "0,200",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpOpened_first_time5",
					"text": "You can also overcharge the warp with any extra charged warp cores to multiply your reward.  I advise you do not do that at this time though, it would be best to use your available cores to complete the highest difficulty on each warp first.",
					"highlight_node": "btnOverCharge",
					"require_node_click": false,
					"offset_vector": "0,200",
					"next_text": "WarpOpened_first_time6",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpOpened_first_time6",
					"text": "Click Jump when you are ready, make sure if you open the warp you also jump or you will receive nothing.  The warp will also fill your shields and reset ability cooldowns.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "0,200",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpClosed_first_time",
					"text": "With the warp closed, a warp core has been used and moved to the end.",
					"highlight_node": "",
					"require_node_click": false,
					"next_text": "WarpClosed_first_time2",
					"offset_vector": "",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "WarpClosed_first_time2",
					"text": "You also received Warp Essence which can be spent in the upgrade section.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Warp",
					"highlight_node_parent": ""
				},
				{
					"id": "DeflectorShield_first_click",
					"text": "Deflectors Shields can completely negate hits.  They don’t provide traditional shields but instead will be able to stop hits occasionally.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"next_text": "DeflectorShield_first_click2",
					"group_display": "Deflector Shield",
					"highlight_node_parent": ""
				},
				{
					"id": "DeflectorShield_first_click2",
					"text": "They have a charge that will build up over time and deflect a hit if it is over a certain % of your shields.  You can set this in the settings much like targeting options.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"next_text": "DeflectorShield_first_click3",
					"group_display": "Deflector Shield",
					"highlight_node_parent": ""
				},
				{
					"id": "DeflectorShield_first_click3",
					"text": "Additionally, each hit you take will serve to build up a Bonus Proc if you have any of the Bonus Buildup stat.  Once full the next hit is deflected automatically without using a charge.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Deflector Shield",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_fifty_clear",
					"text": "We were able to recover advanced materials that will allow us to make Bio Sleeves directly on the ship to print additional crew members.  Click the Crew button",
					"highlight_node": "btnCrew",
					"require_node_click": true,
					"offset_vector": "",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click",
					"text": "Here we can insert stored minds other than yours into Bio Sleeves.  We have selected one prime candidate for now, but more will be available later.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"next_text": "CrewArea_first_click2",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click2",
					"text": "We will start with three Bio Sleeves and can create more over time.  Each one will take longer to create.  Prestiging will reset our Bio Sleeves to three and reset the time taken to make new ones.  It will also reset all active crew members.",
					"highlight_node": "lblSleeveAmount",
					"require_node_click": false,
					"offset_vector": "",
					"next_text": "CrewArea_first_click3",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click3",
					"text": "Click print to use a Bio Sleeve and add the energy technician to our crew.",
					"highlight_node": "btnActiveToggle",
					"require_node_click": true,
					"offset_vector": "0,50",
					"next_text": "CrewArea_first_click4",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click4",
					"text": "Crew members have a primary and secondary stat.  Destroying enemy ships will generate XP for the focused stat.  XP Generated per kill increases significantly with distance and sectors.",
					"highlight_node": "VStats",
					"require_node_click": false,
					"offset_vector": "450,50",
					"next_text": "CrewArea_first_click5",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click5",
					"text": "Stats will also receive a bonus to their XP gain based on the highest the stat has ever been.  But this only kicks in the next time that crew member is printed.",
					"highlight_node": "lblPrevMax",
					"require_node_click": false,
					"offset_vector": "450,50",
					"next_text": "CrewArea_first_click6",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click6",
					"text": "They also have an overall rank which goes up based on their highest stat.  Each rankup will require a larger stat increase than the last.",
					"highlight_node": "VMidrow",
					"require_node_click": false,
					"offset_vector": "450,50",
					"next_text": "CrewArea_first_click7",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click7",
					"text": "Increasing rank will give rank points to spend on upgrades.  These upgrades usually interact with the crew members’ stats or even your crew’s total stats.",
					"highlight_node": "VUpgradeArea",
					"require_node_click": false,
					"offset_vector": "450,50",
					"next_text": "CrewArea_first_click8",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click8",
					"text": "In addition to active crew member use, certain combined milestones will provide upgrades in the upgrade tab.",
					"highlight_node": "btnCrewUpgrades",
					"require_node_click": false,
					"offset_vector": "450,50",
					"group_display": "Crew",
					"next_text": "CrewArea_first_click9",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_first_click9",
					"group_display": "Crew",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Retiring a crew member will reset their stats and rank to 0.  But will allow any bonus XP from a new highest stat level to kick in next time.",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_retire_first",
					"text": "If a crew member gains enough levels within a single prestige, their mastery will increase and permanently improve their XP gain significantly. This will require retiring and printing the same crew member multiple times in a single run.",
					"highlight_node": "lblMastery",
					"require_node_click": false,
					"offset_vector": "450,50",
					"next_text": "CrewArea_retire_first2",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewArea_retire_first2",
					"text": "This bar shows the amount of total stat levels that they need to gain within this prestige to increase their mastery.  It will likely be some time before this is doable.",
					"highlight_node": "prgMastery",
					"require_node_click": false,
					"offset_vector": "450,50",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewUpgradeArea_first_click",
					"text": "Up top are mastery upgrades, you will receive a mastery point every time a crew members mastery is increased and they can be used to select a significant permanent upgrade here.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "0,100",
					"next_text": "CrewUpgradeArea_first_click2",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewUpgradeArea_first_click2",
					"text": "These are permanent upgrades that are automatically granted when you reach certain highest combined stat totals.",
					"highlight_node": "VCrewCombinedUpgrades",
					"require_node_click": false,
					"offset_vector": "0,-100",
					"next_text": "CrewUpgradeArea_first_click3",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewUpgradeArea_first_click3",
					"text": "Crew members do not have to be active to contribute to these. It will always use their highest achieved stat/rank.",
					"highlight_node": "lblCrewCombined",
					"require_node_click": false,
					"offset_vector": "0,-100",
					"group_display": "Crew",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewFirst10RankSpent",
					"group_display": "Crew Rank Upgrade Stats",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The total boost from a rank upgrade doesn’t just depend on the amount of points spent on it.  They are also related to one or more crew member stats.  These are denoted by the bracketed words in the tooltips and can be one of the following.",
					"next_text": "CrewFirst10RankSpent2",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewFirst10RankSpent2",
					"group_display": "Crew Rank Upgrade Stats",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "[Stat Level] means the combined level of that crew member's stats.  So if you have 60 Engineering and 15 Acumen, it will be 75 total.",
					"next_text": "CrewFirst10RankSpent3",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewFirst10RankSpent3",
					"group_display": "Crew Rank Upgrade Stats",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "[Stat] such as [Ingenuity] means just that specific stat for that crew member.",
					"next_text": "CrewFirst10RankSpent4",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewFirst10RankSpent4",
					"group_display": "Crew Rank Upgrade Stats",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "[Active Stat Total] such as [Active Ingenuity Total] means the total of that stat across all active crew members.  So if you have two active crew members with Ingenuity, and one has 50 Ingenuity and the other has 30 Ingenuity, it will be 80 total.",
					"next_text": "CrewFirst10RankSpent5",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewFirst10RankSpent5",
					"group_display": "Crew Rank Upgrade Stats",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You will also see upgrades that have more than one stat listed with a division symbol (/), such as [Engineering]/[Active Acumen Total].  In this example, it means the upgrade will be worse for every point of Acumen you have across all crew members.  Having less Acumen in the divisor is better.",
					"next_text": "CrewFirst10RankSpent6",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewFirst10RankSpent6",
					"group_display": "Crew Rank Upgrade Stats",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Eventually, you will acquire an upgrade that will make these divisors go away, but that is a ways off.",
					"highlight_node_parent": ""
				},
				{
					"id": "CrewFirstNegativeDivisorSpent",
					"group_display": "Crew Rank Upgrade Stats",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You have just put a rank point into an upgrade that has a divisor. This means the upgrade is WORSE for every point of the stat you have in the divisor. You will see red text in the tooltip and an exclamation mark (!) next to the icon when this is the case as a reminder. Do not level the indicated stat if you plan to use this upgrade.",
					"highlight_node_parent": ""
				},
				{
					"id": "death_after_disruption_charge",
					"text": "It looks like we are starting to encounter enemies with PHASING.  If they seem to blink out of existence it means the hit is being absorbed and triggering a phase jump, we can't hit them without disrupting that ability.  The Disruption Charge weapon will be necessary to deal with them unless we do 20x overkill damage.",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"group_display": "Phasing Enemy Tip",
					"highlight_node_parent": ""
				},
				{
					"id": "death_after_barrier",
					"group_display": "Barrier Enemy Tip",
					"highlight_node": "",
					"require_node_click": true,
					"offset_vector": "",
					"text": "These enemies seem to have some form of void barrier. It will only go down by 1 per hit unless we deal significantly more damage than needed. Additionally it looks like the nature of weapons that do tick damage (Beam and Disruptor) cannot directly damage the barrier at all.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_sixty_nine_clear",
					"group_display": "Massive Megastructure",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This is a massive alien megastructure of a different kind than what we have encountered before.  It is far larger and appears to have active weaponry.",
					"highlight_node_parent": ""
				},
				{
					"id": "capital_ship_transition_requirements",
					"group_display": "Capital Ship Transition",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "I am detecting very large alien ships a few sectors away, as well as an odd warp energy signature.  It is likely we will need a significant upgrade to face those ships.",
					"next_text": "capital_ship_transition_requirements2",
					"highlight_node_parent": ""
				},
				{
					"id": "capital_ship_transition_requirements2",
					"group_display": "Capital Ship Transition",
					"highlight_node": "CaptialTransitionHandler",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This will be a larger task than normal.  A list of requirements for this ship upgrade are now showing, some may be hard to complete for now but all will be necessary to enable us to create ships that will rival what I am detecting.  Hover over them for more details.",
					"next_text": "capital_ship_transition_requirements3",
					"highlight_node_parent": ""
				},
				{
					"id": "capital_ship_transition_requirements3",
					"group_display": "Capital Ship Transition",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Improving research and bases will help us hit these goals, so don't neglect them.  Also, to help facilitate completing these tasks, I am generating a Crew Mastery Respec that will show up in the AI Consumables area.",
					"highlight_node_parent": "",
					"next_text": "capital_ship_transition_requirements4"
				},
				{
					"id": "capital_ship_transition_requirements4",
					"group_display": "Capital Ship Transition",
					"highlight_node_parent": "",
					"highlight_node": "TaskListTips",
					"require_node_click": false,
					"offset_vector": "",
					"text": "For more detailed instructions, hover the tips indicator here."
				},
				{
					"id": "BattleCruiser_first_click",
					"group_display": "Capital Ships",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Capital ships have specific slots for capital class weapons and shields.  These are used to battle other capital class ships exclusively.  The normal weapons and shields will be required to continue to combat normal enemy ships for now.",
					"next_text": "BattleCruiser_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleCruiser_first_click2",
					"group_display": "Capital Ships",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We also get access to hangars, which will allow us to launch fighters to attack other enemy capital ships and target specific parts.",
					"next_text": "BattleCruiser_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleCruiser_first_click3",
					"group_display": "Capital Ships",
					"highlight_node": "InnateCapitalSystems",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Capital ships also have innate upgrades just from using the ship. These will vary from ship to ship. Of note, retrofits will refund 100% of the core cost from now on.",
					"next_text": "BattleCruiser_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleCruiser_first_click4",
					"group_display": "Capital Ships",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "And finally, many existing systems will have new functions as we progress.  This will start with compute as soon as you use this ship; you would do well to investigate that right after switching.",
					"highlight_node_parent": ""
				},
				{
					"id": "ComputationArea_first_click_capital",
					"group_display": "Fighters and Compute",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Compute is the main way to improve our fighters for now.  It has been switched to work via tiers instead of pure levels.  You will gain no benefit until you get to the next tier of a given upgrade.",
					"next_text": "ComputationArea_first_click_capital2",
					"highlight_node_parent": ""
				},
				{
					"id": "ComputationArea_first_click_capital2",
					"group_display": "Fighters and Compute",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Improving the fighter’s stats will allow you to break enemy capital ship parts faster, so we can benefit from the temporary disruption and resources gained.",
					"highlight_node_parent": ""
				},
				{
					"id": "enemy_warp_beachhead",
					"group_display": "Enemy Warp Beachhead",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "It looks like this enemy ship is what is keeping the warp open.  It does not appear to have any armaments, so we can easily destroy it.  That should collapse the warp and reduce the enemies ability to inhabit previous sectors eventually.",
					"highlight_node_parent": ""
				},
				{
					"id": "enemy_capital_ship",
					"group_display": "Enemy Capital Ship",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The big enemy is a capital ship.  It will likely keep its distance until we reach the end of the sector.  We can only damage it with a capital sized weapon and can only take hits from it with a capital sized shield.",
					"next_text": "enemy_capital_ship2",
					"highlight_node_parent": ""
				},
				{
					"id": "enemy_capital_ship2",
					"group_display": "Enemy Capital Ship",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The bars you see represent the health of various systems.  The left-most one is its main health, getting through it will temporarily disable its main weapon and buy us time to recover.  The capital ship's damage will also increase over time, and disabling them will reset it.",
					"next_text": "enemy_capital_ship3",
					"highlight_node_parent": ""
				},
				{
					"id": "enemy_capital_ship3",
					"group_display": "Enemy Capital Ship",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The other bars are targetable by your fighters. When depleted, we get resources used to upgrade our capital ship, as well as temporary bonuses versus the enemy's capital ship. By default our fighters will cycle through the targets. This can be changed in the targeting settings on the hangar core.",
					"next_text": "enemy_capital_ship4",
					"highlight_node_parent": ""
				},
				{
					"id": "enemy_capital_ship4",
					"group_display": "Enemy Capital Ship",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Hover over any of the bars for more details.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_seventy_five_clear",
					"group_display": "Fixtures",
					"highlight_node": "btnSynth",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The Synth system now has the capacity to create Fixture upgrades.  Creating a fixture will pause any synthing.  Go to the Synth tab to view available fixtures.",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleFocus_unlocked",
					"group_display": "Battle Focus",
					"highlight_node": "btnCore",
					"require_node_click": true,
					"offset_vector": "",
					"text": "Battle Focus lets us trade S. Battle stats for Capital Battle stats or vice versa, click the Core button.",
					"next_text": "BattleFocus_unlocked2",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleFocus_unlocked2",
					"group_display": "Battle Focus",
					"highlight_node": "BattleFocus",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Use this slider to divert power between the systems.  You can increase either one up to 1.99x and the inverse will occur to the other, resulting in 0.01x for example.",
					"highlight_node_parent": ""
				},
				{
					"id": "high_priority_parts",
					"group_display": "High Priority Parts",
					"highlight_node_parent": "",
					"highlight_node": "GigaLifeBars",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Some enemy capital ships will have an especially dangerous system that is a high priority to keep disabled as much as possible. These parts will be indicated by an additional icon in the display."
				},
				{
					"id": "massive_warp_unlocked",
					"group_display": "Massive Warp Drive",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We have received new warp locations.  However, we need to upgrade our warp drive to reach them with our capital ship.  This will significantly increase the time to charge the cores, but allow us to gather far more Warp Essence, as well as reach new locations.",
					"highlight_node_parent": ""
				},
				{
					"id": "massive_warp_unlocked2",
					"group_display": "Massive Warp Drive",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Proceed to the Warp Drive screen and click the upgrade button.  This will also enable new upgrades in the upgrades tab.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_seventy_nine_clear",
					"group_display": "Reinforce",
					"highlight_node": "btnReinforce",
					"require_node_click": true,
					"offset_vector": "",
					"text": "Initial analysis of the warp the enemy base was sustaining indicates we will eventually be able to use it to bring in fresh reinforcements.  That will enable you to start from scratch, but start working towards establishing a fleet.  Click the Reinforce tab.",
					"next_text": "sector_seventy_nine_clear2",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_seventy_nine_clear2",
					"group_display": "Reinforce",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "0,-200",
					"text": "Here we can do a Reinforcement reset once we reach Sector 80.  You will go back to Sector 1 with most things reset, but gain other significant bonuses.",
					"next_text": "sector_seventy_nine_clear3",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_seventy_nine_clear3",
					"group_display": "Reinforce",
					"highlight_node": "VFleetUpgradeSections",
					"require_node_click": false,
					"offset_vector": "0,-200",
					"text": "Upgrades will be gained based on the highest sector we have reached this reinforce, so reinforce each time we hit a new set of upgrades.",
					"next_text": "sector_seventy_nine_clear4",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_seventy_nine_clear4",
					"group_display": "Reinforce",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "0,-200",
					"text": "After reinforcing at sector 100, we will be able to build up and use Fleet Resources to build and send fleets to various galaxies.",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleCruiserV2_first_click",
					"group_display": "Capital Utility Bonus",
					"highlight_node": "InnateSubCapUtilityFiller",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This version of the Battle Cruiser has no normal utility core slots, instead it has an innate upgrade that is equivalent to all of the normal utility cores at once.",
					"highlight_node_parent": ""
				},
				{
					"id": "massive_reactor_unlocked",
					"group_display": "Massive Reactor",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "That enemy ship contained parts that will finally allow us to upgrade our reactor like we did with our warp drive.  Proceed to the Reactor screen to upgrade.",
					"highlight_node_parent": ""
				},
				{
					"id": "massive_reactor_unlock_click",
					"group_display": "Massive Reactor",
					"highlight_node": "btnCharge",
					"require_node_click": false,
					"offset_vector": "200,0",
					"text": "This upgrade makes the previous power boosts permanent, we do not have to worry about maintaining power for them anymore.  Instead we can charge up various Overdrives and activate them for a short term improvement.",
					"next_text": "massive_reactor_unlock_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "massive_reactor_unlock_click2",
					"group_display": "Massive Reactor",
					"highlight_node": "lblPassive",
					"require_node_click": false,
					"offset_vector": "200,0",
					"text": "Each charge gained, even while capped on charges, also gives us a small permanent upgrade.  This will reach a cap at some point, at which time the Overdrive will be tiered up to provide a larger passive bonus at the cost of increased charge time.",
					"next_text": "massive_reactor_unlock_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "massive_reactor_unlock_click3",
					"group_display": "Massive Reactor",
					"highlight_node": "lblChargeSpeed",
					"require_node_click": false,
					"offset_vector": "200,0",
					"text": "Each Overdrive must be charged individually and can hold 5 charges to start.  Charging depends on the charge speed for that Overdrive; power generation does not matter.",
					"next_text": "massive_reactor_unlock_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "massive_reactor_unlock_click4",
					"group_display": "Massive Reactor",
					"highlight_node": "SpeedUpgradeHolder",
					"require_node_click": false,
					"offset_vector": "200,0",
					"text": "Instead, power can be used to upgrade that Overdrive’s charge speed.",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_first_click",
					"group_display": "Spacemas Event",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "200,0",
					"text": "Spacemas is a temporary event that runs for a limited time during the holiday season.  A special enemy can be found and destroyed for the Giftium resource, which can be used for temporary boosts.",
					"next_text": "spacemas1_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_first_click2",
					"group_display": "Spacemas Event",
					"highlight_node": "VCoalexium",
					"require_node_click": false,
					"offset_vector": "200,0",
					"text": "While the game is open clearing normal enemy waves will grant Coalexium up to the daily limit.  Coalexium and Giftium can be stockpiled and used at any time during the event.  But you will need to make sure you use everything before the event ends.",
					"next_text": "spacemas1_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_first_click3",
					"group_display": "Spacemas Event",
					"highlight_node": "VSantaScanner",
					"require_node_click": false,
					"offset_vector": "200,0",
					"text": "When you have enough Coalexium It can be used to power a scanner to find the special enemy.  Once located you will need to navigate to that location and destroy it.",
					"next_text": "spacemas1_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_first_click4",
					"group_display": "Spacemas Event",
					"highlight_node": "TempUpgrades",
					"require_node_click": false,
					"offset_vector": "200,-200",
					"text": "The Giftium Gained can be spent on any of these temporary boosts.  They will go up by 1 in cost each use, so it will be good to balance the usage a bit.",
					"next_text": "spacemas1_first_click5",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_first_click5",
					"group_display": "Spacemas Event",
					"highlight_node": "GiftiumScroller",
					"require_node_click": false,
					"offset_vector": "200,-200",
					"text": "Gaining  Giftium will also enable you to unlock additional bonuses, culminating in a unique Ship Design.",
					"next_text": "spacemas1_first_click6",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_first_click6",
					"group_display": "Spacemas Event",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "200,-200",
					"text": "You will gain enough Coalexium per day for 3 scans, resulting in 15 Giftium per day.  All permanent bonuses can be attained in 10 days.  There is also a temporary purchase available on the AI tab that boosts Giftium gain and will help unlock the Ship Design faster.",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_gift_giftium",
					"group_display": "Spacemas Gift",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Congratulations on your 3rd kill.  I've acquired 5 extra Giftium as a bonus.",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_gift_coalexium",
					"group_display": "Spacemas Gift",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Congratulations on your 3rd kill.  I was going to give you some extra Giftium but it seems you have a habit of lying to text boxes, so here is 33 more Coalexium instead.",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_gift_coalexium_twice",
					"group_display": "Spacemas Gift",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Congratulations on your 3rd kill.  I've acquired 5 extra Giftium as a... wait...",
					"next_text": "spacemas1_gift_coalexium_twice2",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_gift_coalexium_twice2",
					"group_display": "Spacemas Gift",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You've been lying to text boxes again. It seems the punishment the first time around was not severe enough.",
					"next_text": "spacemas1_gift_coalexium_twice3",
					"highlight_node_parent": ""
				},
				{
					"id": "spacemas1_gift_coalexium_twice3",
					"group_display": "Spacemas Gift",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "I'll give you 33 Coalexium again, but will also be locking out the system for some time, hopefully you learn your lesson this time...",
					"highlight_node_parent": ""
				},
				{
					"id": "first_key_shard",
					"group_display": "Key Shards",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We just found a shard that is resonating oddly with the Void Device.  This Key Shard does not fit in any slots but maxing out its resonance will allow us to gain a new permanent slot to place the corresponding shard in.",
					"next_text": "first_key_shard2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_key_shard2",
					"group_display": "Key Shards",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Once maxed out you can charge the slot by consuming the key shard and focusing the Void Device entirely on charging that slot which will disable all shards temporarily.  Once the slot is charged a Prestige Reset will unlock it for use.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_key_shard_slot_charged",
					"group_display": "Key Shards",
					"highlight_node": "Permabattle_shard",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The new slot will be ready for use after a prestige.  It fits only one specific shard, but will trigger all of the color specific upgrades as well as the normal upgrade.",
					"next_text": "first_key_shard_slot_charged2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_key_shard_slot_charged2",
					"group_display": "Key Shards",
					"highlight_node": "Permabattle_shard",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Additionally, this slot is completely permanent.  It will not go away upon reinforce and neither will the corresponding shard.",
					"highlight_node_parent": ""
				},
				{
					"id": "VeilPiercer_first_click",
					"group_display": "Veil Piercer",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Continued analysis of the warp that last enemy base was sustaining has yielded another breakthrough.  It seems the use of the warp is even more varied than originally thought.",
					"next_text": "VeilPiercer_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "VeilPiercer_first_click2",
					"group_display": "Veil Piercer",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "With this new utility core we will be able to periodically pierce directly through the veil of the warp and drag an alien ship directly out of it.  Since we are able to reach all the way to their point of origination with this, it will be non combat ships.",
					"next_text": "VeilPiercer_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "VeilPiercer_first_click3",
					"group_display": "Veil Piercer",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We should be able to siphon additional resources off of them when destroyed with the proper equipment. Siphoning stats will grant a buff to the specified stat that turns on when one is destroyed.",
					"next_text": "VeilPiercer_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "VeilPiercer_first_click4",
					"group_display": "Veil Piercer",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "As we progress sectors the difficulty multiplier will go up, this increases the bonus we get at the same rate that the charge time increases. It's possible we'll get lucky and find even more valuable enemy ships occasionally.",
					"next_text": "VeilPiercer_first_click5",
					"highlight_node_parent": ""
				},
				{
					"id": "VeilPiercer_first_click5",
					"group_display": "Veil Piercer",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "And finally, once charged and a small warp like area appears, it will automatically trigger in a few seconds.  You can click the area to trigger it instantly.",
					"highlight_node_parent": ""
				},
				{
					"id": "specimen_research_unlocked",
					"group_display": "Specimen Research",
					"highlight_node": "btnResearch",
					"require_node_click": true,
					"offset_vector": "",
					"text": "We now have the facilities required to gather and research specimens that can be received from veiled enemies.  Click the Research tab.",
					"next_text": "specimen_research_unlocked2",
					"highlight_node_parent": ""
				},
				{
					"id": "specimen_research_unlocked2",
					"group_display": "Specimen Research",
					"highlight_node": "SpecimenResearchArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Veiled enemies will drop one of five types of specimen depending on the sector. Once we have at least one of the specific type, research will happen automatically.",
					"next_text": "specimen_research_unlocked3",
					"highlight_node_parent": ""
				},
				{
					"id": "specimen_research_unlocked3",
					"group_display": "Specimen Research",
					"highlight_node": "ZephyrionUpgrades",
					"require_node_click": false,
					"offset_vector": "",
					"text": "All of the research for that specific type of specimen will make progress at the same time and they can all be leveled repeatedly.",
					"next_text": "specimen_research_unlocked4",
					"highlight_node_parent": ""
				},
				{
					"id": "specimen_research_unlocked4",
					"group_display": "Specimen Research",
					"highlight_node": "ZephyrionUpgrades",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The research gained will be multiplied by the amount of specimens we have, so it might be more efficient to gather specimens for a while in each sector.",
					"next_text": "specimen_research_unlocked5",
					"highlight_node_parent": ""
				},
				{
					"id": "specimen_research_unlocked5",
					"group_display": "Specimen Research",
					"highlight_node": "ResearchBonusInfoSpecimen",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Additionally, knowledge of Material, Energy and Observational research Is marginally applicable and will also multiply our research for all specimens by a reduced amount.",
					"highlight_node_parent": ""
				},
				{
					"id": "death_after_capital_barrier",
					"group_display": "Capital Ship Barriers",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "It looks like the enemy capital ships are equipped with a barrier that regenerates quickly.  We will need to use a weapon that fires in bursts to be able to damage them during the time their barrier is down.",
					"highlight_node_parent": ""
				},
				{
					"id": "spaceversary1_first_click",
					"group_display": "Spaceversary Event",
					"highlight_node": "SpaceversaryDates",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Spaceversary is a temporary event that runs for a limited time.  Spatial anomalies are running rampant, we can use a detector to periodically detect these and gain special resources.",
					"next_text": "spaceversary1_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "spaceversary1_first_click2",
					"group_display": "Spaceversary Event",
					"highlight_node": "AnomalyStarter",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The detector will charge while the game is open.  Once ready you can trigger it to make anomalies start spawning in the battle area.",
					"next_text": "spaceversary1_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "spaceversary1_first_click3",
					"group_display": "Spaceversary Event",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Once triggered, you will need to click each anomaly to properly harvest them before they disappear.  Don't click the red ones though as those will drain our resources instead.",
					"next_text": "spaceversary1_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "spaceversary1_first_click4",
					"group_display": "Spaceversary Event",
					"highlight_node": "VVersarite",
					"require_node_click": false,
					"offset_vector": "",
					"text": "When it is finished, you will gain Versarite depending on how many you harvested.  Versarite can be used to upgrade the detector in various ways such as lowering streak requirements or making the anomaly last longer.  You can view upgrades by clicking the button here.",
					"next_text": "spaceversary1_first_click5",
					"highlight_node_parent": ""
				},
				{
					"id": "spaceversary1_first_click5",
					"group_display": "Spaceversary Event",
					"highlight_node": "Yearium",
					"require_node_click": false,
					"offset_vector": "",
					"text": "When you harvest a certain amount of anomalies in a row (starting at 10), you will spawn a special anomaly.  The special anomaly will yield Yearium when harvested.  Triggering the detector will also yield Yearium so you will get some no matter what.",
					"next_text": "spaceversary1_first_click6",
					"highlight_node_parent": ""
				},
				{
					"id": "spaceversary1_first_click6",
					"group_display": "Spaceversary Event",
					"highlight_node": "SpaceversaryTempUpgrade",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Yearium can be used on any of these System Time Skips.  They skip a specific system and give it a very small boost that lasts until the event ends.  They go up by 1 in cost each time (except the first) so spreading them out makes sense.",
					"next_text": "spaceversary1_first_click7",
					"highlight_node_parent": ""
				},
				{
					"id": "spaceversary1_first_click7",
					"group_display": "Spaceversary Event",
					"highlight_node": "YeariumController",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Gaining Yearium will also enable you to unlock additional bonuses, culminating in a unique Ship Design.",
					"next_text": "spaceversary1_first_click8",
					"highlight_node_parent": ""
				},
				{
					"id": "spaceversary1_first_click8",
					"group_display": "Spaceversary Event",
					"highlight_node": "YeariumController",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can gain 15 Yearium a day. All permanent bonuses can be attained in 10 days.  There is also a temporary purchase available on the AI tab that boosts Yearium and Versarite gain and will help unlock the Ship Design faster.",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetArea_first_click",
					"group_display": "Fleet",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Now that we have Reinforced enough to start gaining Fleet Resources, we can use them to explore galaxies and attempt to find where the aliens have come from.",
					"next_text": "FleetArea_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetArea_first_click2",
					"group_display": "Fleet",
					"highlight_node": "HFleetResources",
					"require_node_click": false,
					"offset_vector": "",
					"text": "These are the base amount of Fleet Resources that we can take to galaxies.  The only way to increase this value is to reach higher sectors.  However, we will also be able to increase the total we bring to specific galaxies from within those galaxies.",
					"next_text": "FleetArea_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetArea_first_click3",
					"group_display": "Fleet",
					"highlight_node": "AstriumDisplay",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Transiting to a galaxy requires Astrium Fuel. This is automatically generated over time and can't easily be sped up.  It is expressed here as a time for convenience as you gain it per second. Fortunately, we have some available already.",
					"next_text": "FleetArea_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetArea_first_click4",
					"group_display": "Fleet",
					"highlight_node": "lblTransitTime",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Here you can see the amount of Astrium Fuel required to go to the galaxy and how much you have.",
					"next_text": "FleetArea_first_click5",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetArea_first_click5",
					"group_display": "Fleet",
					"highlight_node": "lblRecommendedFR",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The Recommended Fleet Resources refers to your baseline amount of Fleet Resources. You can make progress in the galaxy with less than this amount, but progress will be smoother if you have at least the recommended amount.",
					"next_text": "FleetArea_first_click6",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetArea_first_click6",
					"group_display": "Fleet",
					"highlight_node_parent": "",
					"highlight_node": "lblMaxFR",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can only increase the baseline for the galaxy up to this maximum amount, any new high sectors reached past that will instead reduce the fuel cost.",
					"next_text": "FleetArea_first_click7"
				},
				{
					"id": "FleetArea_first_click7",
					"group_display": "Fleet",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Astrium Fuel, progress within galaxies, and everything else fleet related will persist through Reinforces.",
					"next_text": "FleetArea_first_click8",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetArea_first_click8",
					"group_display": "Fleet",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "When you are ready to continue, hit the View button to go to that galaxy's screen.",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetGalaxy_first_click",
					"group_display": "Fleet Galaxies",
					"highlight_node": "TravelDetails",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Right now we are just viewing the galaxy.  Here you can see the Fleet Resources we will be able to bring to the galaxy, as well as how much Astrium Fuel it will take to get there.",
					"next_text": "FleetGalaxy_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetGalaxy_first_click2",
					"group_display": "Fleet Galaxies",
					"highlight_node": "btnStartTravel",
					"require_node_click": true,
					"offset_vector": "",
					"text": "Hit Travel to initiate travel to this galaxy.",
					"next_text": "FleetGalaxy_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetGalaxy_first_click3",
					"group_display": "Fleet Galaxies",
					"highlight_node": "HResources",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Our resources in this galaxy are displayed here.  Fleet Resources are important to our progress in the galaxy and is what is used to deploy our ships in battle, establish a foothold or upgrade our fleet.  When you run out, finish the current run and travel to it again for a refill.",
					"next_text": "FleetGalaxy_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetGalaxy_first_click4",
					"group_display": "Fleet Galaxies",
					"highlight_node": "FleetScrap",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Fleet Scrap will be generated from battles and is used to permanently upgrade fleet stats or resources in this specific Galaxy. When leaving the galaxy, any left over Fleet Scrap and Fleet Resources will automatically be distributed.",
					"next_text": "FleetGalaxy_first_click5",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetGalaxy_first_click5",
					"group_display": "Fleet Galaxies",
					"highlight_node": "g1_1_b1",
					"require_node_click": true,
					"offset_vector": "",
					"text": "There are several different types of nodes on the Galaxy Map. Our point of entry to the Galaxy will always be the left most Battle Node and our ultimate goal is to get to and destroy the enemy at the final Battle Node on the right. Select this first Battle Node",
					"next_text": "FleetGalaxy_first_click6",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetGalaxy_first_click6",
					"group_display": "Fleet Galaxies",
					"highlight_node": "lblInfoPanelName",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Selecting a node will open the info panel.  The information here will vary depending on the node.",
					"next_text": "FleetGalaxy_first_click7",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetGalaxy_first_click7",
					"group_display": "Fleet Galaxies",
					"highlight_node": "RewardArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Since this is a battle node, you can see the rewards here. The first time you beat them, battle nodes usually reward you with increased Fuel Efficiency which decreases the fuel required to travel to the galaxy. They also reward you with Fleet Scrap every time you beat them.  You can also see the enemy information, when there is more than one enemy you can select them to see more info.",
					"next_text": "FleetGalaxy_first_click8",
					"highlight_node_parent": ""
				},
				{
					"id": "FleetGalaxy_first_click8",
					"group_display": "Fleet Galaxies",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "While in a Fleet Battle, your main ship and all the systems will continue working in the background. Hit the View Battle button on this node when you are ready to proceed",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle",
					"group_display": "Fleet Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This is the Fleet Battle screen.  Here you will deploy ships from your fleet to battle enemy ships.  You can see the enemy fleet on the right side.  We will deploy our fleet on the left side.  You can see more details on an enemy by selecting them.",
					"next_text": "first_fleet_battle2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle2",
					"group_display": "Fleet Battles",
					"highlight_node": "MainShipButton",
					"require_node_click": true,
					"offset_vector": "",
					"text": "Up top are our ships to select from as well as the bar showing our Fleet Resources.  Right now we only have the Corvette, and only 1 as you can see from the 0/1 below it.  Select the Corvette.",
					"next_text": "first_fleet_battle3",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle3",
					"group_display": "Fleet Battles",
					"highlight_node": "VStatInfo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Here you can see more information about the selected ship.  Note the # Ships display.  That is how many ships will deploy in this group, the stats (except DPS) reflect just one ship, not the whole group.",
					"next_text": "first_fleet_battle4",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle4",
					"group_display": "Fleet Battles",
					"highlight_node": "lblCost",
					"require_node_click": false,
					"offset_vector": "",
					"text": "In addition to how many of each ship you have available, you will need enough Fleet Resources to deploy the ship, you will get some of this back depending on how the battle goes.",
					"next_text": "first_fleet_battle5",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle5",
					"group_display": "Fleet Battles",
					"highlight_node": "HSkinSelection",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can choose which Ship Design (that you have unlocked) to use on the ship using the buttons next to the ship icon.",
					"next_text": "first_fleet_battle6",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle6",
					"group_display": "Fleet Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Deploy a Corvette by hitting the Deploy Ship button or dragging the ship onto the deployment grid from the button up top.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_deploy",
					"group_display": "Fleet Battles",
					"highlight_node": "FleetResourcesBar",
					"require_node_click": false,
					"offset_vector": "",
					"text": "When we added the ship it increased our fleet resources committed.  When you start the battle half of the resources committed will be consumed immediately and the rest will be consumed as our ships sustain damage.",
					"next_text": "first_fleet_battle7",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle7",
					"group_display": "Fleet Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Basically, the better the battle goes the less resources get used.  So it's best to complete the battle with the minimum amount of ships but still taking minimal damage.  You can attempt the battle repeatedly until you are happy with the results or abandon it and come back later.",
					"next_text": "first_fleet_battle8",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle8",
					"group_display": "Fleet Battles",
					"highlight_node": "lblCost",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Since you have deployed your only ready to go Corvette, any more will be considered overdeployment and cost double the resources to use. Try to overcome battles without overdeployment, but sometimes you will need to.",
					"next_text": "first_fleet_battle9",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle9",
					"group_display": "Fleet Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Positioning is important, ships simply attack the closest enemy and will attack the same target if they are not lined up properly.  Your ships can be dragged to other slots on the grid to reposition.",
					"next_text": "first_fleet_battle10",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle10",
					"group_display": "Fleet Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Once you are ready, hit Start Battle in the top left.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_win",
					"group_display": "Fleet Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Assuming you win it will show your resources committed and your total lost, or spent.  Once you hit accept you will officially use those resources and cannot attempt to battle again for a better outcome until you do the next run of the galaxy.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_ship_node",
					"group_display": "Fleet Ship Node",
					"highlight_node": "InfoPanelShipChoice",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This is a ship node, You can choose a ship to add to your fleet depending on what you have unlocked.  These nodes typically cost fleet resources and are not permanent.  Meaning next time you are in the galaxy you will have to spend the resources again to add a ship again.",
					"next_text": "first_fleet_ship_node2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_ship_node2",
					"group_display": "Fleet Ship Node",
					"highlight_node": "btnChooseShip",
					"require_node_click": true,
					"offset_vector": "",
					"text": "You will often need to use these nodes to be able to clear future battles.  For now there is no choice so just hit choose ship to add another Corvette to your fleet.",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_undo",
					"group_display": "Fleet Node Undo",
					"highlight_node": "btnUndo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can always undo your actions on nodes until you finish the run, so if it turns out you need to choose a different ship, or spend your resources differently, you can do that.",
					"next_text": "fleet_undo2",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_undo2",
					"group_display": "Fleet Node Undo",
					"highlight_node": "btnResetGalaxy",
					"require_node_click": false,
					"offset_vector": "",
					"text": "In addition to finding the node and hitting undo, you can also bring up the undo interface at any point with this button.",
					"next_text": "fleet_undo3",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_undo3",
					"group_display": "Fleet Node Undo",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Note that this is just for undoing everything, when you are actually done and want to commit the run and gain everything, hit Finish Current Run at the top.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_ship_node_with_frigate",
					"group_display": "Fleet Ship Node",
					"highlight_node": "HShipChoice",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You unlocked Frigates in your last run, you will need one to defeat armored enemies in this galaxy so choose a frigate this time.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_foothold_node",
					"group_display": "Fleet Foothold Node",
					"highlight_node": "ContributionReqArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This is a special node that you can spend any left over Fleet Resources on to slowly improve your fleet stats and Fleet Resources amount.  You should not contribute to this until you are stuck as completing battles and using the Fleet Scrap from them on other nodes is usually far more efficient.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_contribution_node",
					"group_display": "Fleet Contribution Node",
					"highlight_node": "ContributionReqArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This is a Contribution Node.  They take various resources and give permanent upgrades.  Your progress is kept in between runs of the galaxy, so don't worry about saving up to fill the bar in one go every time.",
					"next_text": "first_fleet_contribution_node2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_contribution_node2",
					"group_display": "Fleet Contribution Node",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "These usually either increase your fleet's combat stats, or multiply the Fleet Resources you can bring into the Galaxy on future runs.  Filling these out is very important to progression within the Galaxy ",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_resource_node",
					"group_display": "Fleet Resource Node",
					"highlight_node": "ResourceSwapArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This is a resource exchange node.  Usually these allow you to get Artifacts in exchange for one of the other resources.  Artifacts are used for upgrades to your main ship that will take effect on your next Reinforce.  You can see these by clicking the Upgrades button up at the top right of the Galaxy screen.",
					"next_text": "first_fleet_resource_node2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_resource_node2",
					"group_display": "Fleet Resource Node",
					"highlight_node": "Artifacts",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Artifacts are not lost when exiting the Galaxy, you will build them up over several runs until you have enough for all of the upgrades.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle_node_revisit",
					"group_display": "Fleet Previously Cleared Battles",
					"highlight_node": "lblPreviousClearDetails",
					"require_node_click": false,
					"offset_vector": "",
					"text": "When viewing a battle you have cleared before, you will see some additional information about that clear. Assuming you have the same ships and temporary node choices as before, you will see \"Matching Clear\" information here and the Auto Complete Battle button will be available.",
					"next_text": "first_fleet_battle_node_revisit2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_battle_node_revisit2",
					"group_display": "Fleet Previously Cleared Battles",
					"highlight_node": "lblPreviousClearDetails",
					"require_node_click": false,
					"offset_vector": "",
					"text": "If you do not have all the same ships and temporary nodes, it will instead say \"No matching clear found\" and show you information relating to your best clear.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_frigate_unlock",
					"group_display": "Fleet Ship Unlocks",
					"highlight_node": "ContributionReqArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This is a special Contribution Node that unlocks a new ship type to use. It is important to complete these as soon as you can so you have them to better counter the enemy fleet. After unlocking this node, the next time you travel to the galaxy you will be able to select the Frigate on the ship choice node. Fully unlock this now if you are able.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_armored_battle",
					"group_display": "Fleet Battle Composition",
					"highlight_node": "BattleRequirementDisplay",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This battle has an armored enemy which your Corvettes are not very effective against.  You likely will not be able to clear this battle until you have unlocked a Frigate and have it in your fleet as the Frigate has kinetic weapons by default and will be effective against the armored enemy.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_mod_unlock",
					"group_display": "Fleet Mods",
					"highlight_node": "RewardArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This Contribution Node unlocks a Mod for a ship. Ship mods change weapons and stats on the ship that they are for.  They apply to all ships of that type in the battle and are needed to better counter the enemy fleet.  You can select the Mod during a Fleet Battle to enable it.",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_mi_weapon",
					"group_display": "Fleet Missiles",
					"highlight_node_parent": "",
					"highlight_node": "ShipModFrigateMissileMod",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Certain weapons do better against specific enemies. Equip your Missile Launcher by selecting it here, it will do well against these Swarm enemies."
				},
				{
					"id": "fleet_cl_weapon",
					"group_display": "Fleet Charge Laser",
					"highlight_node_parent": "",
					"highlight_node": "ShipModCorvetteChargeLaserMod",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Certain weapons do better against specific enemies. Equip your Charge Laser by selecting it here, it will do well against these Shotgun enemies."
				},
				{
					"id": "first_fleet_base_battle",
					"group_display": "Fleet Enemy Base Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This battle has more enemy ships than normal, you will likely need to Overdeploy to win.",
					"next_text": "first_fleet_base_battle2",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_base_battle2",
					"group_display": "Fleet Enemy Base Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "There is also an enemy base. The base will shoot back and instantly kill any ship that attacks it, but otherwise will not participate in the battle. The base's health will persist between battles and galaxy runs. You will likely need to do some damage to the base and then come back and finish it off next run. This battle will not count as fully complete until you have reduced the base's health to 0.",
					"next_text": "first_fleet_base_battle3",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_base_battle3",
					"group_display": "Fleet Enemy Base Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "As long as you destroy all the enemy ships it will be considered a victory, and then you can do some damage to the base.",
					"next_text": "first_fleet_base_battle4",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_base_battle4",
					"group_display": "Fleet Enemy Base Battles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You will need to \"win\" these style of battles several times to destroy the base in most circumstances.",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_upgrades_first_click",
					"group_display": "Fleet Artifact Upgrades",
					"highlight_node": "GridArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Here you can spend Artifacts on various upgrades. Levels in these upgrades will not activate until you Reinforce. When you decide to Reinforce, make sure to spend all your available Artifacts first.",
					"next_text": "fleet_upgrades_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_upgrades_first_click2",
					"group_display": "Fleet Artifact Upgrades",
					"highlight_node": "GridArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Starting from the top middle upgrade, all upgrades require at least one level in an adjacent upgrade before they can be purchased. The price of the upgrades increase as you go down the grid or out to the sides when the grid is bigger.",
					"next_text": "fleet_upgrades_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_upgrades_first_click3",
					"group_display": "Fleet Artifact Upgrades",
					"highlight_node": "btnResetSpent",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Since the levels in these upgrades don't activate until a Reinforce, you can freely reset any Artifacts spent on the upgrades that have not yet been activated via Reinforce here.",
					"next_text": "fleet_upgrades_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_upgrades_first_click4",
					"group_display": "Fleet Artifact Upgrades",
					"highlight_node": "HArtifactsTotal",
					"require_node_click": false,
					"offset_vector": "",
					"text": "It takes a fixed amount of Artifacts to max out the grid, displayed here. Once you have this many, the Artifact nodes in the Exploration tab will no longer cost Fleet Resources.",
					"next_text": "fleet_upgrades_first_click5",
					"highlight_node_parent": ""
				},
				{
					"id": "fleet_upgrades_first_click5",
					"group_display": "Fleet Artifact Upgrades",
					"highlight_node": "btnUpgradeToggle",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can view the cumulative effect of these upgrades here.",
					"highlight_node_parent": ""
				},
				{
					"id": "g2_3_bb1_first_click",
					"group_display": "Void and Scrap Removal Upgrade",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Completing this base battle rewards an upgrade that is a permanent replacement for Void Energy and Salvage Scrap. Once acquired, the auto collection modules for those will be fully removed since they would do nothing.",
					"highlight_node_parent": ""
				},
				{
					"id": "galaxy2_battle9_first_battle",
					"group_display": "Fleet Enemy Base Battles",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The final battles in a Galaxy will always be a Base Battle. You will most likely need to Overdeploy to deal damage to the Base. As long as you deal some damage it will stay and you can battle again next visit picking up where it left off."
				},
				{
					"id": "fleet_damage_type_indicators",
					"group_display": "Fleet Damage Type Indicators",
					"highlight_node_parent": "FleetGalaxy3",
					"highlight_node": "HEnemies",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Some enemies do extra damage to Hull, Armor or Shields. That is indicated by icons on the bottom right of the enemy ship, in this case it is Hull Damage. It is also listed in the stats area."
				},
				{
					"id": "fleet_repeatable_artifact_node",
					"group_display": "Fleet Repeatable Artifact Nodes",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The final Artifact node in the galaxy is usually repeatable. You can keep claiming these Artifacts as long as you have enough Fleet Resources"
				},
				{
					"id": "g3_6_fr_msc_first_click",
					"group_display": "Fleet Medium Class Ships",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This node lets you get a medium class ship, so it costs more to deploy and is more powerful.  Ships will attempt to move towards and target ships of their own class at the start of a battle, so position appropriately",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_onehundred_two_clear",
					"group_display": "Capital Ship Support Weapons",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The enemy capital ship in this next sector has support weapons that continue to fire even when it is disabled. You can combat that by selecting Shield Regen nodes on the 2.0 Capital Shield.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_onehundred_three_clear",
					"group_display": "Capital Ship Shield",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The enemy capital ship in this next sector has a shield that regenerates. Your fighters can destroy the shield generator to reduce the regeneration rate. The shield generator replaces the Hangar Bay.",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleShip_first_click",
					"group_display": "Battle Ship",
					"highlight_node": "InnateSmallScaleInvuln",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This larger capital ship is immune to small scale weapon damage and has two new types of slots. The first is a special slot for a more powerful small scale weapon to take care of smaller ships easier.",
					"next_text": "BattleShip_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleShip_first_click2",
					"group_display": "Battle Ship",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The second is a slot for a Combat Amplifier. While the ship is immune to small scale damage, taking that damage will reduce the effectiveness of the equipped Combat Amplifier.  Once it is on you will be able to see its status in the left of the battle area.",
					"next_text": "BattleShip_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "BattleShip_first_click3",
					"group_display": "Battle Ship",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You also lose the Battle Focus slider as the Combat Amplifier partially replaces it. We will be able to fit other Combat Amplifiers later.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_onehundred_ten_clear",
					"group_display": "Capital Large Barrier",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The enemy capital ship in this next sector has a large regenerating barrier.  Make sure to configure our weapons accordingly.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_onehundred_twelve_clear",
					"group_display": "Anti Fighter Missiles",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "It looks like the enemy capital ship has upgraded their anti-fighter weapons in this next sector.  They are using missiles that can not be evaded.  Fortunately, we can now use an upgraded fighter.",
					"highlight_node_parent": ""
				},
				{
					"id": "alien_synthing_unlock",
					"group_display": "Alien Synthing",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Alien Synthing has its own set of materials and persists through Reinforce.  There is a new checkbox on the synth screen that will show or hide the Recipes and materials.",
					"highlight_node_parent": ""
				},
				{
					"id": "sector_onehundred_sixteen_clear",
					"group_display": "Capital Torpedo Tubes",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The enemy capital ship in this next sector fires massive torpedoes that do a lot of damage but move slowly. You can damage them with the Plasma Chainers, which will do 1 damage per hit until you can increase your point defense damage later. Damaging the Torpedo will reduce how hard they hit you.  Fighters can target the Torpedo Tubes on the enemy capital to slow down the launch rate and speed.",
					"highlight_node_parent": ""
				},
				{
					"id": "ut_first_click",
					"group_display": "Fleet Unstable Transit",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Transiting and battling in various galaxies has led to the discovery of unstable regions with a new type of Artifact we can use for upgrades. We will need to defend a base while battling multiple enemy fleets in a row to harvest them.",
					"next_text": "ut_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "ut_first_click2",
					"group_display": "Fleet Unstable Transit",
					"highlight_node": "lblInstability",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We require Instability to start the process. An Instability will be generated over 24 hours and we can store up to 4. We can also use excess fuel to speed up this process.",
					"next_text": "ut_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "ut_first_click3",
					"group_display": "Fleet Unstable Transit",
					"highlight_node": "GridSelectableUpgrades",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The Unstable Artifacts earned will be fed into the upgrade we select here before we start. The upgrades that are eligible will change every run, you can see the other potential upgrades on the right.",
					"next_text": "ut_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "ut_first_click4",
					"group_display": "Fleet Unstable Transit",
					"highlight_node": "UTLevelSelect",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The Origin Galaxy determines our starting fleet and what enemies we face. Later galaxies also multiply our artifacts gained. Completing a galaxy in the standard Fleet mode will unlock it here.",
					"next_text": "ut_first_click5",
					"highlight_node_parent": ""
				},
				{
					"id": "ut_first_click5",
					"group_display": "Fleet Unstable Transit",
					"highlight_node": "btnUnstableTransitGo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We have an Instability now, so select an upgrade and then use this button to start. Or you can do a simulation run first using the Simulate button above, this costs no resources but has no rewards.",
					"highlight_node_parent": ""
				},
				{
					"id": "ut_first_run_done",
					"group_display": "Fleet Unstable Transit",
					"highlight_node_parent": "",
					"highlight_node": "lblLastOfficialRun",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Now that we have a successful run, it has been banked as you can see here. We can now use this banked run to instantly get Artifacts. Doing so will reduce the banked stage so the uses are limited.",
					"next_text": "ut_first_run_done2"
				},
				{
					"id": "ut_first_run_done2",
					"group_display": "Fleet Unstable Transit",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The first run of each day is tracked and you can see your results for the last few, as well as a ranking on how well you did, with the bottom button."
				},
				{
					"id": "ut_first_battle",
					"group_display": "Fleet Unstable Transit Run",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Unlike battles in a galaxy, Fleet Resources are not a concern here, but we can not over deploy. Thus there is no reason to not deploy a ship.",
					"next_text": "ut_first_battle2"
				},
				{
					"id": "ut_first_battle2",
					"group_display": "Fleet Unstable Transit Run",
					"highlight_node_parent": "",
					"highlight_node": "RoguelikeHealthBar",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We can keep going until our base is destroyed. It is busy harvesting Unstable Artifacts, but if an enemy reaches and damages it the enemy will be destroyed.",
					"next_text": "ut_first_battle3"
				},
				{
					"id": "ut_first_battle3",
					"group_display": "Fleet Unstable Transit Run",
					"highlight_node_parent": "",
					"highlight_node": "pnlUTInfo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We can see the Stage, Modifiers (if any) and Artifacts gained so far here. We will harvest the maximum Artifacts by completing stage 10."
				},
				{
					"id": "ut_stage10_clear",
					"group_display": "Fleet Unstable Transit Run",
					"highlight_node_parent": "",
					"highlight_node": "pnlUTInfo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Completing stage 10 has yielded the maximum amount of Artifacts we can get. But continuing on will potentially let us re-use this run's result more times. More details on that once finished."
				},
				{
					"id": "ut_first_reward",
					"group_display": "Fleet Unstable Transit Run",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "After every battle we will be able to upgrade our ships. Unlike within a Galaxy, the mods chosen here can usually be stacked and are permanently on and can not be turned off."
				},
				{
					"id": "galaxy_five_hazards",
					"group_display": "Fleet Hazards",
					"highlight_node": "g5a_b3",
					"require_node_click": true,
					"offset_vector": "",
					"text": "Many of the battles in this galaxy contain Hazards. You can tell there is a hazard based on the letter next to the node on the map. The different letters represent different hazards. Select this battle node.",
					"next_text": "galaxy_five_hazards2",
					"highlight_node_parent": ""
				},
				{
					"id": "galaxy_five_hazards2",
					"group_display": "Fleet Hazards",
					"highlight_node": "HHazardArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Once selected, you can see a little more detail in the panel here. But to really understand the effect, you will just need to see it in the battle.",
					"next_text": "galaxy_five_hazards3",
					"highlight_node_parent": "FleetGalaxy5"
				},
				{
					"id": "galaxy_five_hazards3",
					"group_display": "Fleet Hazards",
					"highlight_node": "g5a_b6",
					"require_node_click": true,
					"offset_vector": "",
					"text": "Selecting a node will also highlight the node that is causing the hazard, if there is one. In this case the B6A node is what is causing this, select that node.",
					"next_text": "galaxy_five_hazards4",
					"highlight_node_parent": ""
				},
				{
					"id": "galaxy_five_hazards4",
					"group_display": "Fleet Hazards",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Now all the nodes that have a hazard due to this node are highlighted, once you defeat the special enemy at this node all those hazards will go away and the battles will be much easier.",
					"next_text": "galaxy_five_hazards5",
					"highlight_node_parent": ""
				},
				{
					"id": "galaxy_five_hazards5",
					"group_display": "Fleet Hazards",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Additionally, there will sometimes be no node causing the hazard and you won't be able to remove it. Nodes can also have multiple hazards affecting them.",
					"highlight_node_parent": ""
				},
				{
					"id": "first_fleet_adaptive_node",
					"group_display": "Fleet Adaptive Nodes",
					"highlight_node": "lblAdaptiveCost",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This node is adaptive, we will be able to optimize every time we clear it and the cost will go down until it becomes free.",
					"highlight_node_parent": "FleetGalaxy5"
				},
				{
					"id": "first_fleet_hazard_battle",
					"group_display": "Fleet Hazards",
					"highlight_node_parent": "",
					"highlight_node": "pnlHazardArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This battle has hazards, you can see the information here. You will likely need to Overdeploy to deal with hazards in general."
				},
				{
					"id": "g5_cruiser_armor_tank_first_click",
					"group_display": "Fleet Damage Block",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This node will unlock a Cruiser mod that blocks some damage every hit. This can make the Cruiser very good in battles with Hazards that do small amounts of damage rapidly.",
					"next_text": "g5_cruiser_armor_tank_first_click2"
				},
				{
					"id": "g5_cruiser_armor_tank_first_click2",
					"group_display": "Fleet Damage Block",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Damage block will never fully negate damage, you will still take 25% of the damage at minimum."
				},
				{
					"id": "galaxy5_battle29_first_battle",
					"group_display": "Fleet Hazards",
					"highlight_node_parent": "",
					"highlight_node": "pnlHazardArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This Hazard is a bit different than normal, if this damage occurs you won't be able to survive so you need to finish the fight fast."
				},
				{
					"id": "Splice_first_click",
					"group_display": "Splicing",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Crew can now be spliced with different Alien Specimens. Each crew has different Specimen that can be used and they will each have different upgrades. There is no limit to how many crew are active, but they must be unlocked.",
					"next_text": "Splice_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "Splice_first_click2",
					"group_display": "Splicing",
					"highlight_node": "splice_firstVerdanix",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Instead of Stats, Spliced Crew have Aspects. Only one can be active and leveling at a time. They level off of Mastery which is earned when you disable/kill an enemy capital ship in sector 117 or higher. All of the previous Mastery upgrades apply.",
					"next_text": "Splice_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "Splice_first_click3",
					"group_display": "Splicing",
					"highlight_node": "CorruptionAspectRows",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Before splicing, you can select which Alien Aspect to use, they have their own separate upgrades. You can cycle through them with the Change Aspect button.",
					"next_text": "Splice_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "Splice_first_click4",
					"group_display": "Splicing",
					"highlight_node_parent": "",
					"highlight_node": "S1VerdanixInfusion",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can spend Specimen of the corresponding type here to increase the Crew Member's Acclimation Rate for this aspect.  Acclimation is very important as it will lower the Corruption caused, this will be further explained later.",
					"next_text": "Splice_first_click5"
				},
				{
					"id": "Splice_first_click5",
					"group_display": "Splicing",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The Splice/Cleanse button is the equivalent of the previous Crew Print/Retire, while Mastery is the new XP. Splice this crew member when ready to continue.",
					"highlight_node_parent": ""
				},
				{
					"id": "Splice_first_click6",
					"group_display": "Splicing",
					"highlight_node": "pbCorruption",
					"require_node_click": false,
					"offset_vector": "",
					"text": "When leveling, you will be limited by your Corruption. Every level of an Alien Aspect will increase Corruption, but every level of Discipline will increase your Humanity which decreases Corruption. When Corruption is capped, you won't be able to level the Alien Aspects until you level Discipline more.",
					"next_text": "Splice_first_click7",
					"highlight_node_parent": ""
				},
				{
					"id": "Splice_first_click7",
					"group_display": "Splicing",
					"highlight_node": "CorruptionAspectRows",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Alien Aspects gain ranks and are how you generate Rank Points. When you have more than one, they individually rank up so you can get rank points faster by leveling both.",
					"next_text": "Splice_first_click8",
					"highlight_node_parent": ""
				},
				{
					"id": "Splice_first_click8",
					"group_display": "Splicing",
					"highlight_node": "splice_firstDiscipline",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Discipline is harder to level and does not gain Acclimation, Ranks, or give Rank Points.",
					"next_text": "Splice_first_click9",
					"highlight_node_parent": ""
				},
				{
					"id": "Splice_first_click9",
					"group_display": "Splicing",
					"highlight_node": "CorruptionAspectRows",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Once you have at least one level in an Alien Aspect, the Crew Member will start getting Acclimated to it. Acclimation will reduce the Corruption the Aspect creates.",
					"next_text": "Splice_first_click10",
					"highlight_node_parent": ""
				},
				{
					"id": "Splice_first_click10",
					"group_display": "Splicing",
					"highlight_node": "AcclimationProgress",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You gain Acclimation faster the higher the current level for the Aspect. Make getting Acclimation levels a priority as they will let you get higher Aspect levels and they also affect Adaptation upgrades.",
					"next_text": "Splice_first_click11",
					"highlight_node_parent": "splice_firstVerdanix"
				},
				{
					"id": "Splice_first_click11",
					"group_display": "Splicing",
					"highlight_node": "splice_firstVerdanix",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Getting Acclimation is very important, so select the Alien Aspect as the focus for now.",
					"highlight_node_parent": ""
				},
				{
					"id": "Adaptation_first_click",
					"group_display": "Splicing Adaptations",
					"highlight_node": "Adaptations",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Adaptation upgrades can be worked towards while the crew is not active.",
					"next_text": "Adaptation_first_click2",
					"highlight_node_parent": ""
				},
				{
					"id": "Adaptation_first_click2",
					"group_display": "Splicing Adaptations",
					"highlight_node": "lblAdaptationSpeed",
					"require_node_click": false,
					"offset_vector": "",
					"text": "They go faster based on the total Acclimation to Alien Aspects on this Crew Member, and require at least 1 level of Acclimation to increase at all.",
					"next_text": "Adaptation_first_click3",
					"highlight_node_parent": ""
				},
				{
					"id": "Adaptation_first_click3",
					"group_display": "Splicing Adaptations",
					"highlight_node": "lblAdaptationsAmount",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can only have 1 active at a time for now.",
					"next_text": "Adaptation_first_click4",
					"highlight_node_parent": ""
				},
				{
					"id": "Adaptation_first_click4",
					"group_display": "Splicing Adaptations",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You will need to switch between focusing on leveling Aspects to help level Acclimation faster, and leveling these Adaptations to boost that process further.",
					"highlight_node_parent": ""
				},
				{
					"id": "SpliceUpgradeArea_first_click",
					"group_display": "Splicing Upgrades",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "These upgrades are purchased with either Humanity or Corruption points.",
					"next_text": "SpliceUpgradeArea_first_click2"
				},
				{
					"id": "SpliceUpgradeArea_first_click2",
					"group_display": "Splicing Upgrades",
					"highlight_node_parent": "",
					"highlight_node": "lblCurrentSpliceTotal",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Points are granted based on your current total, so you will need to specifically focus all crew towards Humanity or Corruption at once to hit the next threshold and receive another point.",
					"next_text": "SpliceUpgradeArea_first_click3"
				},
				{
					"id": "SpliceUpgradeArea_first_click3",
					"group_display": "Splicing Upgrades",
					"highlight_node_parent": "",
					"highlight_node": "lblStatAmountInfo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can see what you need to reach for another point here.",
					"next_text": "SpliceUpgradeArea_first_click4"
				},
				{
					"id": "SpliceUpgradeArea_first_click4",
					"group_display": "Splicing Upgrades",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Your Humanity and Corruption are at odds with each other, so these totals will always be exact opposites."
				},
				{
					"id": "sector_onehundred_twentytwo_clear",
					"group_display": "Capital Reactive Armor",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The enemy capital ship in this next sector has Reactive Armor that reduces damage. The reduction increases every time it is damaged so slow firing weapons work better. It will decay over time and fighters can destroy the part which will cause it to decay faster."
				},
				{
					"id": "fleet_unlock_nodes",
					"group_display": "Fleet Unlock Nodes",
					"highlight_node_parent": "FleetGalaxy6",
					"highlight_node": "AcquireArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Fleet nodes with a lock on them have a Fleet Resource contribution requirement before they can be used. Each node only needs to be unlocked once, then the node can be accessed like normal."
				},
				{
					"id": "fleet_support_nodes",
					"group_display": "Fleet Support Nodes",
					"highlight_node_parent": "FleetGalaxy6",
					"highlight_node": "g6_bu_damage1",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This is a friendly support node, essentially the opposite of a hazard producing enemy base. It shows the nodes it will support with a green border.",
					"next_text": "fleet_support_nodes2"
				},
				{
					"id": "fleet_support_nodes2",
					"group_display": "Fleet Support Nodes",
					"highlight_node_parent": "FleetGalaxy6",
					"highlight_node": "FriendlyHazardArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "We will need to activate this each galaxy visit to use it. Eventually it may be possible to skip activating this node to save Fleet Resources but that is usually difficult."
				},
				{
					"id": "galaxy6_battle28_first_battle",
					"group_display": "Fleet Grid Buffs",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Some battles will have deployment grid slots with buffs on them. They will buff whatever ship is placed there. Select the ship to see the effect of the buff."
				},
				{
					"id": "TetherWarp_first_click",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "",
					"highlight_node": "TetherWarpCore",
					"require_node_click": false,
					"offset_vector": "",
					"text": "The Warp Drive has been upgraded with the ability to Tether to new warp locations and automatically harvest resources from them.",
					"next_text": "TetherWarp_first_click2"
				},
				{
					"id": "TetherWarp_first_click2",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "Oizys",
					"highlight_node": "lblLocked",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Before we can use it on a warp location, we need to clear that warp at least one time.",
					"next_text": "TetherWarp_first_click3"
				},
				{
					"id": "TetherWarp_first_click3",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "Oizys",
					"highlight_node": "btnJump",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Fortunately we don't have to open a warp, we can just jump to it any time. Jump to this warp when ready and able to clear it."
				},
				{
					"id": "TetherWarp_Oizys_done",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "Oizys",
					"highlight_node": "btnSetTether",
					"require_node_click": true,
					"offset_vector": "",
					"text": "Now that a jump has been completed we can set the Tether to this location. Set it now.",
					"next_text": "TetherWarp_Oizys_done2"
				},
				{
					"id": "TetherWarp_Oizys_done2",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "Oizys",
					"highlight_node": "VTetherInfo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Once tethered, the Warp Drive will charge and automatically generate Skein from that specific warp when done. Skein is used for upgrades, we no longer get or use Warp Essence.",
					"next_text": "TetherWarp_Oizys_done3"
				},
				{
					"id": "TetherWarp_Oizys_done3",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "Oizys",
					"highlight_node": "lblDischargeTime",
					"require_node_click": false,
					"offset_vector": "",
					"text": "After charging, the Warp Drive will need to discharge. We can't increase the speed of this for now.",
					"next_text": "TetherWarp_Oizys_done4"
				},
				{
					"id": "TetherWarp_Oizys_done4",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "Oizys",
					"highlight_node": "lblResiduumGain",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Discharging will generate Residuum, which is also used for upgrades. So a full cycle will charge and generate Skein, then discharge and grant Residuum.",
					"next_text": "TetherWarp_Oizys_done5"
				},
				{
					"id": "TetherWarp_Oizys_done5",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Residuum is generated from all warps, but Skein is specific to the warp that is tethered. The charge time and Residuum generated can differ however."
				},
				{
					"id": "TetherWarp_upgrades",
					"group_display": "Warp Tethering",
					"highlight_node_parent": "",
					"highlight_node": "HTetheredWarpInfo",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Upgrades are separated out into a tree for each warp, and one for Residuum. Switch trees to any that are unlocked with the navigation buttons here."
				},
				{
					"id": "fleet_distant_galaxies",
					"group_display": "Distant Galaxies",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Now that we have gained complete control of these galaxies and exploited their artifacts, we can use this as a staging point to reach more distant galaxies by Reinforcing. This will unlock the next galaxies."
				},
				{
					"id": "fleet_distant_galaxies_fr_reduction",
					"group_display": "Distant Galaxies",
					"highlight_node_parent": "GalaxyInfoBoxgalaxy7",
					"highlight_node": "lblFRReducer",
					"require_node_click": false,
					"offset_vector": "",
					"text": "These new galaxies are more difficult to get resources to, we are only able to bring 10% of our total Fleet Resources through to this first galaxy. Every sector gained will still increase the amount, but future galaxies may be even more difficult.",
					"next_text": "fleet_distant_galaxies_instant_artifacts"
				},
				{
					"id": "fleet_distant_galaxies_instant_artifacts",
					"group_display": "Distant Galaxies",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "However, thanks to the large amount of artifacts discovered and studied in previous galaxies, we can now apply the artifact upgrades instantly instead of on Reinforce. You can do this with the Apply Selected Upgrades button on the Artifacts screen."
				},
				{
					"id": "first_fleet_patrol_node",
					"group_display": "Fleet Patrol Node",
					"highlight_node_parent": "FleetGalaxy8",
					"highlight_node": "ShipPatrolArea",
					"require_node_click": false,
					"offset_vector": "",
					"text": "This node requires you to leave a ship to Patrol the area. 1 of the selected ship will be removed from your fleet, if you have 0 of a ship you won't be able to deploy any.",
					"next_text": "first_fleet_patrol_node2"
				},
				{
					"id": "first_fleet_patrol_node2",
					"group_display": "Fleet Patrol Node",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You will need to look at the upcoming battles to best determine which ship to assign to the Patrol, don't get rid of one that will be useful for the next several battles. Which ship to choose will also depend on your plans for a given run.",
					"next_text": "first_fleet_patrol_node3"
				},
				{
					"id": "first_fleet_patrol_node3",
					"group_display": "Fleet Patrol Node",
					"highlight_node_parent": "FleetGalaxy8",
					"highlight_node": "g8_b2",
					"require_node_click": false,
					"offset_vector": "",
					"text": "For example, B2 has both armored and shielded skirmishers, so it would be good to have both a frigate and fighter for that battle, so selecting Corvette to Patrol would be optimal. Then change that when you are attempting BB1 since a Corvette is more useful there."
				},
				{
					"id": "powercells_unlocked",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Since all Overdrives have been maxed out, Overdrive Charge Speed can now be used to power additional upgrades.",
					"next_text": "powercells_unlocked2"
				},
				{
					"id": "powercells_unlocked2",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "VPowerCells",
					"require_node_click": false,
					"offset_vector": "",
					"text": "There are several Cells that will become available, they each have a set of upgrades that will activate based on your current Overdrive Charge Speed.",
					"next_text": "powercells_unlocked3"
				},
				{
					"id": "powercells_unlocked3",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "lblODAmount",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can see how much Overdrive Charge Speed is needed under each upgrade.",
					"next_text": "powercells_unlocked4"
				},
				{
					"id": "powercells_unlocked4",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "lblLoops",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Once you have enough for all the upgrades, it will loop back to the start and you can get another level in each upgrade.",
					"next_text": "powercells_unlocked5"
				},
				{
					"id": "powercells_unlocked5",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "lblBaselineLoops",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Reducing your Overdrive Charge Speed can mean losing the upgrades, but you will never go below your Baseline loops shown here. This goes up every loop you complete so you will only lose one level of each upgrade at most."
				},
				{
					"id": "powercells_move",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "btnReactor",
					"require_node_click": true,
					"offset_vector": "",
					"text": "You reached enough Overdrive Charge Speed to unlock a second Cell. Click the Reactor tab",
					"next_text": "powercells_move2"
				},
				{
					"id": "powercells_move2",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "All Cells past 1 have a number of loops that must be completed before they become available.",
					"next_text": "powercells_move3"
				},
				{
					"id": "powercells_move3",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "ODPowercell2",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Cells will fill one after the other, not at the same time. You need to fill all unlocked cells to complete a loop.",
					"next_text": "powercells_move4"
				},
				{
					"id": "powercells_move4",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "ODPowercell2",
					"highlight_node": "VPowercellMove",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You can also change the order of Cells. This will only effect the current loop you are on and does not change the required loops before a given Cell activates.",
					"next_text": "powercells_move5"
				},
				{
					"id": "powercells_move5",
					"group_display": "Reactor Powercells",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "Switching the order will allow you to choose which upgrades to get first while you are working towards another full loop."
				},
				{
					"id": "sector_onehundred_fortyone_clear",
					"group_display": "End of Content Reached",
					"highlight_node_parent": "",
					"highlight_node": "",
					"require_node_click": false,
					"offset_vector": "",
					"text": "You have reached the current end of \"normal\" content.  More is being actively developed, but until the next content patch is in place, you are missing an important scaling reduction upgrade that makes progression from here very very slow."
				}
			],
			"separators": [],
			"props": {}
		},
